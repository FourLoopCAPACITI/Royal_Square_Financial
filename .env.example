# ─────────────────────────────────────────────────────────────
# Royal Square Financial — environment variables
# Copy this file to `.env.local` and fill in the values.
# The app runs WITHOUT any of these (it falls back to mock data).
# ─────────────────────────────────────────────────────────────

# Supabase (browser-safe). Project Settings → API in Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo mode: lets the team switch between Client View and Adviser View
# without real accounts. Set to "false" before any real launch.
VITE_ENABLE_DEMO_MODE=true

# Groq (SERVER-SIDE ONLY). Used by api/chat.js (Vercel Function).
# Never prefix these with VITE_ — that would expose them in the browser.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NEVER put the Supabase service-role key in this project's frontend.
